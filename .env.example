# Public Supabase project settings used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin key. Never import this from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# App URLs used by Stripe callbacks and server routes.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_URL=

# Optional legacy compatibility fallback for some routes.
NEXT_PUBLIC_SITE_URL=

# Optional map/search providers used in local development.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_YAHOO_APPID=
YAHOO_API_KEY=
YAHOO_APP_ID=
